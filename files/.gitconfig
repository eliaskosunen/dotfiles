[user]
    email = elias.kosunen@gmail.com
    name = Elias Kosunen
[credential]
    helper = cache --timeout=7200
[diff]
    tool = vimdiff
[merge]
    tool = vimdiff
    conflictstyle = zdiff3

[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green
[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold
[color "status"]
    added = green
    changed = yellow
    untracked = cyan

[url "git@github.com:"]
    insteadOf = gh:
    insteadOf = github:
[url "git@github.com:eliaskosunen/"]
    insteadOf = ek:
[url "https://gitlab.com/"]
    insteadOf = gl:
    insteadOf = gitlab:
[url "https://bitbucket.org/"]
    insteadOf = bb:
    insteadOf = bitbucket:
[url "https://gist.github.com/"]
    insteadOf = gist:
[core]
    fsmonitor = true
[init]
    defaultBranch = master
[push]
    autoSetupRemote = true
[rerere]
    enabled = true
    autoUpdate = true
[branch]
    sort = -committerdate
[rebase]
    updateRefs = true

# Machine-specific settings (signing key, maintenance repos), not tracked in the
# dotfiles repo. Last, so that it can override anything above.
[include]
    path = ~/.gitconfig.local
